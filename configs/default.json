{
  "data": {
    "directory": "data/raw",
    "holdout_fraction": 0.2,
    "n_similarity_bins": 8,
    "n_matching_rounds": 3,
    "seed": 0
  },
  "features": {
    "fingerprint_bits": 2048,
    "fingerprint_radius": 2,
    "use_physicochemical": true,
    "use_mechanistic": true
  },
  "conditioning": {
    "strategy": "factorised",
    "embedding_dim": 8
  },
  "multifidelity": {
    "strategy": "extra_rows",
    "screen_weight": 0.3,
    "tdi_weight": 0.5,
    "surrogate_estimators": 300
  },
  "model": {
    "kind": "boosted",
    "objective": "soft_threshold",
    "n_members": 5,
    "boosted": {
      "n_estimators": 600,
      "learning_rate": 0.05,
      "num_leaves": 63,
      "min_child_samples": 20,
      "subsample": 0.8,
      "colsample_bytree": 0.6
    },
    "neural": {
      "hidden": 256,
      "dropout": 0.2,
      "epochs": 60,
      "batch_size": 256,
      "learning_rate": 0.001,
      "forward_passes": 30
    },
    "graph": {
      "hidden": 300,
      "depth": 3,
      "dropout": 0.1,
      "epochs": 30,
      "batch_size": 64
    },
    "curve": {
      "hidden": 256,
      "dropout": 0.2,
      "epochs": 60,
      "batch_size": 256,
      "learning_rate": 0.001,
      "forward_passes": 30,
      "conditioning": "heads",
      "descriptor_sources": [
        "curated"
      ],
      "screen_noise": 0.1
    }
  },
  "tracking": {
    "enabled": false,
    "project": "cyp-shift",
    "entity": null,
    "tags": []
  },
  "auxiliary": {
    "max_distance": 1.5,
    "weighting": "exponential",
    "scale": 1.0,
    "target_weight": 1.0
  }
}
